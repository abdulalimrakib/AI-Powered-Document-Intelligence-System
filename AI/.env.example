# Free API key from https://aistudio.google.com
GEMINI_API_KEY=
# Optional. Models to use, best first, separated by commas. When one model's free daily limit
# is used up, the next one is used. Leave empty for the default list in extract_invoice.py.
GEMINI_MODELS=

# Optional: the model for meaning search (embeddings). Default: gemini-embedding-001
GEMINI_EMBEDDING_MODEL=
